<!DOCTYPE html>
<html lan="en">

<head>
    <meta name="descriere" content="apartment, hosting, booking, mansion, penthouse, house">
    <link rel="stylesheet" href="/resurse/css/stays.css">
    <%- include("../fragmente/head")%>
        <script type="text/javascript" src="/resurse/js/stays.js"></script>

</head>

<body>
    <%- include("../fragmente/header")%>
        <main>
            <fieldset class="filtrare-sections">
                <legend>Filters</legend>
                <fieldset>
                    <label>City:<input type="text" id="inp-city" placeholder="Search by city...">
                    </label>
                </fieldset>

                <fieldset>
                    <label>Dimension:
                        <span class="range-min">
                            <%=dimMin%>
                        </span>
                        <input type="range" id="inp-dim" value="10" min="<%=dimMin%>" max="<%=dimMax%>">
                        <span class="range-max">
                            <%=dimMax%>
                        </span>
                        <span class="info-range">(0)</span>
                    </label>
                </fieldset>
                <fieldset>
                    <label>Property name:<input type="text" id="inp-nume" placeholder="Type a name..."
                            list="lista-nume">
                        <datalist id="lista-nume">
                            <% for(let stay of locals.stays){%>
                                <option value="<%-stay.nume_proprietate%>"></option>
                                <%}%>
                        </datalist>
                    </label>
                </fieldset>
                <fieldset>
                    <legend>Options</legend>
                    <label><input type="radio" name="gr_tip" value="all" checked>All</label>
                    <!-- checkboxul gr_all este individual de celelate pt ca are alt "name" -->
                    <label><input type="radio" name="gr_tip" value="penthouse">Penthouse</label>
                    <label><input type="radio" name="gr_tip" value="apartment">Apartment</label>
                    <label><input type="radio" name="gr_tip" value="house">House</label>
                    <label><input type="radio" name="gr_tip" value="mansion">Mansion</label>
                </fieldset>

                <fieldset>
                    <legend>Animal friendly</legend>
                    <label><input type="checkbox" id="inp-animal">Animal friendly only</label>
                </fieldset>

                <fieldset>
                    <legend>Description</legend>
                    <label>
                        <textarea id="inp-descriere" rows="3" placeholder="Search by description">
                        </textarea>
                    </label>
                </fieldset>
                <fieldset>
                    <legend>Bedrooms</legend>
                    <label>Nmber of bedrooms
                        <select id="inp-bedrooms">
                            <option value="">All/option>
                            <option value="1">1 bedroom</option>
                            <option value="2">2 bedrooms</option>
                            <option value="3">3 bedrooms</option>
                            <option value="4">4+ bedrooms</option>
                        </select>
                    </label>
                </fieldset>
                <fieldset>
                    <legend>Guests</legend>
                    <label>Number of guests:
                        <input type="number" id="inp-guests" min="1" max="30" value="1">
                    </label>
                </fieldset>
                <fieldset>
                    <legend>Price</legend>
                    <select id="inp-price" multiple>
                        <option value="100-200">100-200</option>
                        <option value="200-300">200-300</option>
                        <option value="300-400">300-400</option>
                        <option value="400-1000">400-1000</option>
                    </select>
                </fieldset>
                <div class="content-area">
                    <p><button class="c1 c2 c3 btn btn-primary btn-sm w-100" id="filtrare">
                            <i class="bi bi-search"></i>
                            <span class="d-none d-md-inline"> Filter</span>
                        </button>
                    </p>

                    <button id="sortCrescNume">
                        <i class="bi bi-sort-alpha-down"></i>
                        <span class="d-none d-md-inline"> Sort crescator dupa nume si pret</span>
                    </button>

                    <button id="sortDescrescNume">
                        <i class="bi bi-sort-alpha-up"></i>
                        <span class="d-none d-md-inline"> Sort descrescator dupa nume si pret</span>
                    </button>

                    <button id="reset">
                        <i class="bi bi-x-circle"></i>
                        <span class="d-none d-md-inline"> Reset</span>
                    </button>

                    <p class="suma">ALT+C for the sum of the stays</p>
                </div>

            </fieldset>

            <div class="content-stays">
                <h2>Stays</h2>
                <p class="mesaj-gol" style="display: none">No available stays</p>
                <div class="grid-stays">
                    <% for(let stay of locals.stays){%>
                        <article class="stay-article">
                            <div class="not-photo-container">

                                <h3 class="denumire">Name: <a href="/stay/<%-stay.id%>"><span
                                            class="val-name"><%-stay.nume_proprietate%></span>
                                    </a></h3>

                                <p class="categ">Stay Type:<span class="val-categ">
                                        <%-stay.tip_proprietate%>
                                    </span></p>

                                <p class="bed">Bedrooms:<span class="val-bedrooms">
                                        <%-stay.nr_dormitoare%>
                                    </span></p>


                                <p class="descriere-stay">Details:<span class="val-descriere"><%-stay.descriere%></span>
                                </p>


                                <div class="stay-information">
                                    <p class="price-per-night">Price: <span class="val-price"><%-stay.pret_noapte%>
                                        </span>€/night
                                    </p>

                                    <p class="nr_guests">Guests:<span class="val-guests"><%-stay.nr_persoane%></span>
                                    </p>

                                    <!-- oras info -->
                                    <p class="city">City:<span class="city-name"><%-stay.oras%></span></p>
                                    <p class="dimensiune">Dimension: <span class="val-dimensiune">
                                            <%-stay.dimensiune_mp%>
                                        </span>mp</p>
                                    <p class="amenities">Amenities:
                                    <ul class="val-amenities">
                                        <% for(let i=0;i<stay.facilitati.length;i++){%>
                                            <li>
                                                <%= stay.facilitati[i]%>
                                            </li>
                                            <%}%>
                                    </ul>
                                    </p>
                                    <p class="pet">Animal-friendly
                                        <span class="val-pet">
                                            <% if(stay.animal_friendly){ %>
                                                <span class="emoji">✅</span>
                                                <% } else { %>
                                                    <span class="emoji">❌</span>
                                                    <% } %>
                                        </span>
                                    </p>
                                    <% let zileRo=["Duminica","Luni", "Marți" , "Miercuri" , "Joi" , "Vineri"
                                        , "Sâmbătă" ]; let luniRo=["Ianuarie", "Februarie" , "Martie" , "Aprilie"
                                        , "Mai" , "Iunie" , "Iulie" , "August" , "Septembrie" , "Octombrie"
                                        , "Noiembrie" , "Decembrie" ]; let d=new Date(stay.data_creare); let
                                        ziSapt=zileRo[d.getDay()]; let zi=d.getDate(); let luna=luniRo[d.getMonth()];
                                        let an=d.getFullYear(); let dataFormatata=`${ziSapt}, ${zi}-${luna}-${an}`; %>
                                        <p class=" data-creare">Data:<span class="val-data-creare"><time
                                                    datetime="<%-stay.data_creare%>"><%-dataFormatata%></time></span>
                                        </p>
                                </div>
                                <label class="selecteaza-cos">
                                    Select:</br>
                                    <input type="checkbox" class="select-cos" value="<%-stay.id %>" autocomplete="off">
                                </label>
                            </div>
                            <div class="photo">
                                <figure>
                                    <a href="/stay/<%-stay.id%>">
                                        <img src="<%-stay.imagine%>" alt="[image <%-stay.nume_proprietate%>]" />
                                    </a>
                                    <figcaption></figcaption>
                                </figure>
                            </div>

                            <!-- <label class="selecteaza-cos">
                                Select:</br>
                                <input type="checkbox" class="select-cos" value="<%-stay.id %>" autocomplete="off">
                            </label> -->
                        </article>
                        <% } %>
                </div>
            </div>



        </main>

        <%- include("../fragmente/footer") %>
</body>

</html>