<header>
    <h1 class="logo">CityStay</h1>
    <nav>
        <label id="hamburger" for="ch-menu">
            <img src="/resurse/imagini/hamburger_menu.png" alt="Menu">
        </label>
        <input type="checkbox" id="ch-menu">
        <ul class="menu">
            <li><a href="#"><i class="fa-solid fa-house"></i>Home</a>
                <ul class="submenu">
                    <li><a href="/index#about">About</a></li>
                    <li><a href="/index#faq">Faq</a></li>
                </ul>
            </li>

            <li><a href="#"><i class="fa-solid fa-user"></i>Become a member</a>
                <ul class="submenu">
                    <li><a href="/inregistrare">Register</a></li>
                    <li><a href="#register">Log In</a></li>
                </ul>
            </li>

            <li><a href="#"><i class="fa-solid fa-plane"></i>Stays</a>
                <ul class="submenu">
                    <li><a href="/index#stays">Popular Stays</a></li>
                    <li><a href="/index#top-destinations">Top Destinations</a></li>
                </ul>
            </li>
            <li><a href="#"><i class="fa-solid fa-globe"></i>Explore Stays</a>
                <ul class="submenu">
                    <li><a href="/stays">All</a></li>
                    <% for( let categ of (locals.categorii || [])){%>
                        <li><a href="/stays?tip=<%-categ%>">
                                <%- categ.charAt(0).toUpperCase() + categ.slice(1)%>
                            </a></li>
                        <%}%>
                </ul>
            </li>
            <li><a href="/index#how-citystay-works"><i class="fa-solid fa-magnifying-glass"></i>How It Works</a></li>
            <li><a href="/index#events"><i class="fa-solid fa-calendar"></i>Events</a></li>
        </ul>

        <div class="form-check form-switch ms-auto">
            <input class="form-check-input" type="checkbox" id="theme-switch">
            <label class="form-check-label" for="theme-switch">
                <i class="bi bi-moon" id="theme-icon" style="color: black; font-size: 1.5rem;"></i>
            </label>
        </div>
        <% if (!locals.utilizator) { %>
            <% if (locals.errLogin) { %>
                <p style="color:red">
                    <%= errLogin %>
                </p>
                <% } %>

                    <form action="/login" method="POST" class="login-form">
                        <input type="text" name="username" placeholder="Username">
                        <input type="password" name="password" placeholder="Password">
                        <button type="submit">Login</button>
                    </form>
                    <% } else { %>
                        <div class="user-menu">
                            <span>Logat: <%= utilizator.username %></span>
                            <div class="submeniu">
                                <a href="/logout">Delogare</a>
                            </div>
                        </div>
                        <% } %>


    </nav>
</header>